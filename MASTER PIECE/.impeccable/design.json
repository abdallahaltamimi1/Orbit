      "html": "<button class=\"ds-primary\">Continue</button>",
      "css": ".ds-primary{font-family:var(--orbit-font,'Segoe UI',Tahoma,Arial,sans-serif);background:var(--orbit-action,#2563eb);color:var(--orbit-on-action,#fff);padding:11px 17px;border:0;border-radius:10px;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,transform 160ms cubic-bezier(.23,1,.32,1)}.ds-primary:active:not(:disabled){transform:scale(.98)}.ds-primary:hover{filter:brightness(.97)}.ds-primary:disabled{opacity:.55;cursor:not-allowed}.ds-primary:focus-visible,.ds-soft:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-choice:focus-visible{outline:2px solid var(--orbit-focus,#2563eb);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"

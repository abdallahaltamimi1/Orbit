      "html": "<label class=\"ds-label\" for=\"ds-name\">Name</label><input class=\"ds-input\" id=\"ds-name\" autocomplete=\"name\" placeholder=\"Your name\">",
      "css": ".ds-label{font-family:var(--orbit-font,'Segoe UI',Tahoma,Arial,sans-serif);display:block;color:var(--orbit-ink,#17243a);font-size:13px;font-weight:600;line-height:1.6}.ds-input{font-family:var(--orbit-font,'Segoe UI',Tahoma,Arial,sans-serif);display:block;width:100%;padding:12px 14px;margin-top:8px;border:1px solid var(--orbit-border,#dce4ef);border-radius:var(--orbit-radius,14px);background:var(--orbit-surface,#fff);color:var(--orbit-ink,#17243a);font-size:14px;line-height:1.55;transition:border-color 180ms ease}.ds-input:hover{border-color:var(--orbit-accent,#2563eb)}.ds-input::placeholder{color:var(--orbit-muted,#64748b);opacity:1}.ds-input[aria-invalid=true]{border-color:var(--orbit-error,#b4233b)}.ds-primary:focus-visible,.ds-soft:focus-visible,.ds-input:focus-visible,.ds-nav a:focus-visible,.ds-choice:focus-visible{outline:2px solid var(--orbit-focus,#2563eb);outline-offset:3px}"

  "narrative": {
    "northStar": "One learning universe, three recognizable experiences",
    "overview": "The user-pinned blue direction replaces the former violet platform identity. This is a code-led system extracted from shared tokens, role themes, cinematic presentation and registration source; no randomized concept seed or approved image composition exists.\n\nStudents explore colorful learning destinations, teachers work in a calm publishing studio, and schools use structured discovery and management surfaces. Neutral reading regions keep forms and real educational data legible. The protected homepage space hero retains its existing composition, renderer and local art palette; translations do not redesign its artwork.",
    "keyCharacteristics": [
      "Blue foundations and purposeful role accents.",
      "Readable Arabic and English with native controls.",
      "Quiet workspaces beside selected scientific imagery.",
      "Finite motion and graceful decorative fallbacks."
    ],
    "rules": [
      {
        "name": "The Action Contrast Rule",
        "body": "Bright learning blue, turquoise and teacher teal are expressive accents; white-label actions use the darker action tokens. Do not substitute bright accents into action backgrounds without checking contrast.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use semantic tokens and the role-specific action shade.",
      "Do preserve bilingual layouts, keyboard focus and supported native behavior.",
      "Do show progress, profiles and empty states from actual application data.",
      "Do keep finite scene motion subordinate to readable forms."
    ],
    "donts": [
      "Don't restore a violet-heavy platform identity outside the protected homepage hero artwork.",
      "Don't invent ratings, activity, authentication flows or unsupported settings.",
      "Don't treat client-side permission checks as server authorization.",
      "Don't claim isolated-browser screenshots prove real-device GPU performance or production security."
    ]
  }
